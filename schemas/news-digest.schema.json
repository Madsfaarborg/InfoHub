{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfoHub daily news digest",
  "description": "Candidate research output. Editorial review and semantic validation precede publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "windowStart",
    "windowEnd",
    "timezone",
    "status",
    "items",
    "modelReviewCandidates",
    "sourceFailures",
    "noNewsReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Europe/Copenhagen"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/newsItem"
      }
    },
    "modelReviewCandidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/modelReviewCandidate"
      }
    },
    "sourceFailures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceFailure"
      }
    },
    "noNewsReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "sourceFailures": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "sourceFailures": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          },
          "modelReviewCandidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "noNewsReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "publisher",
        "publishedDate",
        "eventDate",
        "retrievedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publishedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "eventDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "newsItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventKey",
        "title",
        "summary",
        "whyItMatters",
        "suggestedAction",
        "tags",
        "urgency",
        "confidence",
        "recommendationImpact",
        "primarySource",
        "additionalSources",
        "supersedesEventKey"
      ],
      "properties": {
        "eventKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "suggestedAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "models-and-pricing",
              "coding-tools",
              "networking",
              "cybersecurity",
              "microsoft-and-cloud",
              "work-practices",
              "creative-tools",
              "business-productivity"
            ]
          }
        },
        "urgency": {
          "enum": [
            "routine",
            "time-sensitive"
          ]
        },
        "confidence": {
          "enum": [
            "confirmed",
            "vendor-claim"
          ]
        },
        "recommendationImpact": {
          "enum": [
            "none",
            "review"
          ]
        },
        "primarySource": {
          "$ref": "#/$defs/source"
        },
        "additionalSources": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "supersedesEventKey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "modelReviewCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "variantIds",
        "evidenceUrls",
        "verificationNeeded"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "variantIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "verificationNeeded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "sourceFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "reason"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
