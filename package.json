{
  "name": "infohub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start-local.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "ci": "npm run content -- check-release && npm run typecheck && npm test && npm run build && npm run test:smoke",
    "content": "node --import tsx scripts/content.ts",
    "content:ship": "node scripts/ship-content.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
